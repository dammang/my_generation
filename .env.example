APP_NAME="My Generation"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://khanggui.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=my_generation
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# Must be on a domain registered with Apple under Sign in with Apple for Email
# Communication, with SPF covering whatever actually sends. Apple users who
# choose Hide My Email get a @privaterelay.appleid.com address, and Apple drops
# mail to it from unregistered domains without telling anyone — so an invitation
# to an Apple user simply never arrives.
MAIL_FROM_ADDRESS="hello@khanggui.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── Media storage (S3 / Cloudflare R2 compatible) ───────────────────────
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_URL=
R2_REGION=auto

# ── Genealogy domain tunables (see config/genealogy.php) ────────────────
GENEALOGY_LIVING_MAX_AGE=110
GENEALOGY_MINOR_AGE=18
GENEALOGY_TREE_MAX_DEPTH=8
GENEALOGY_TREE_DEFAULT_ANCESTORS=3
GENEALOGY_TREE_DEFAULT_DESCENDANTS=2
GENEALOGY_TREE_MAX_NODES=800
GENEALOGY_TREE_DEFAULT_NODES=400
GENEALOGY_TREE_CACHE_TTL=3600
GENEALOGY_DUPLICATE_THRESHOLD=0.82
GENEALOGY_TRUST_RAMP=0
GENEALOGY_DEFAULT_PRIVACY=family
GENEALOGY_MULTI_TRIBE=true

# Browser origins allowed to call the API. Empty is correct for a mobile-only
# deployment; the app is not a browser and is not subject to CORS.
CORS_ALLOWED_ORIGINS=

# Leave unset so a token lasts until it is revoked. Set a number of minutes
# where a deployment needs sessions to expire on their own.
SANCTUM_TOKEN_MINUTES=

# Firebase is the identity provider for the mobile app and the transport for
# push. Media stay on R2; auth here is exchanged for a Sanctum token, so the
# permission model is unchanged.
#
# A service account JSON from the Firebase console (Project Settings ->
# Service Accounts -> Generate new private key), kept OUTSIDE the repository.
#
# This is not optional for sign-in. Verifying an ID token builds an API client,
# and without credentials that fails with "Unable to create an API client
# without credentials" — which surfaces in the app as a failed sign-in, not as
# anything that points at the server.
FIREBASE_CREDENTIALS=/absolute/path/to/service-account.json

# The project id is normally read from the credentials file. Set this only when
# running without one. The name is GOOGLE_CLOUD_PROJECT because that is the
# variable the Firebase SDK actually reads — an earlier FIREBASE_PROJECT_ID here
# was read by nothing at all.
GOOGLE_CLOUD_PROJECT=
