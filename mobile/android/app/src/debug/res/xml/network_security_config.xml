<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only — this file lives in src/debug and is never merged into a
  release APK, where the API is reached over https and cleartext stays blocked.

  Named hosts rather than a blanket cleartextTrafficPermitted="true": the point
  of the platform default is that unencrypted traffic is a real risk, and a
  developer's convenience should not quietly switch it off for every host the
  app will ever talk to.

  10.0.2.2 is how the Android emulator reaches the host machine's loopback —
  127.0.0.1 inside the emulator is the emulator itself.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
